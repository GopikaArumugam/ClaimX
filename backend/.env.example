# Application Environment
APP_NAME="ClaimX Research Platform"
APP_ENV="development"
APP_VERSION="1.0.0"
API_V1_STR="/api/v1"
PORT=5000

# PostgreSQL + pgvector Connection (Cloud / Container)
# Defaults to local SQLite research store if PostgreSQL instance is not provided
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/claimx_db"
FALLBACK_SQLITE_URL="sqlite:///./claimx_research.db"
USE_POSTGRES="false"

# Security & JWT Authentication
JWT_SECRET_KEY="claimx-scopus-research-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Confidence-Aware Recovery Thresholds (Centralized - Section 13)
DOCUMENT_CONFIDENCE_THRESHOLD=0.80
VISION_CONFIDENCE_THRESHOLD=0.75
POLICY_CONFIDENCE_THRESHOLD=0.85
DECISION_CONFIDENCE_THRESHOLD=0.85
FRAUD_REVIEW_THRESHOLD=0.45
MAX_AUTO_APPROVAL_AMOUNT_INR=50000.0
MAX_AGENT_RETRIES=2

# Research Reproducibility (Section 27)
RANDOM_SEED=42
EXPERIMENT_VERSION="exp-v1.0"
